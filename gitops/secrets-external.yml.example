# ==============================================================================
# Production Secret Management with External Secrets Operator (ESO)
# This replaces storing plaintext secrets in Git with dynamic AWS Secrets Manager sync.
# ==============================================================================
apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: aws-secrets-manager
spec:
  provider:
    aws:
      service: SecretsManager
      region: us-east-1
      auth:
        jwt:
          serviceAccountRef:
            name: external-secrets-sa
            namespace: external-secrets
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: boutique-secrets-sync
  namespace: boutique
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: aws-secrets-manager
    kind: ClusterSecretStore
  target:
    name: boutique-secrets
    creationPolicy: Owner
  data:
    - secretKey: POSTGRES_PASSWORD
      remoteRef:
        key: prod/boutique/database
        property: password
    - secretKey: AUTH_DB_URL
      remoteRef:
        key: prod/boutique/database
        property: auth_db_url
    - secretKey: PRODUCTS_DB_URL
      remoteRef:
        key: prod/boutique/database
        property: products_db_url
    - secretKey: ORDERS_DB_URL
      remoteRef:
        key: prod/boutique/database
        property: orders_db_url
    - secretKey: USERS_DB_URL
      remoteRef:
        key: prod/boutique/database
        property: users_db_url
